# Copia este archivo como .env y reemplaza todos los valores.
APP_ENV=development
APP_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-esta-clave
DATABASE_PATH=data/msastrologia.db
GEODATA_PATH=data/geonames.db
PUBLIC_BASE_URL=http://127.0.0.1:8000
RESULTS_DIR=output/pdf

# Correo automatico. Para Hostinger suele usarse puerto 465 con ssl.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_SECURITY=ssl

# URL completa del endpoint /messages de WhatsApp Cloud API y token oficial de Meta.
# Si se dejan vacios, el panel muestra botones de correo y WhatsApp preparados para envio manual.
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
DEFAULT_COUNTRY_DIAL_CODE=57
ASTROLOGY_API_KEY=
