# Copia este archivo como .env antes de desplegar.
APP_ENV=production
APP_SECRET=GENERA_UN_SECRETO_LARGO_Y_ALEATORIO
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA
PUBLIC_BASE_URL=https://tudominio.com
APP_PORT=8000

# Estas rutas ya coinciden con los volumenes de docker-compose.yml.
DATABASE_PATH=/app/storage/db/msastrologia.db
GEODATA_PATH=/app/data/geonames.db
RESULTS_DIR=/app/storage/pdf

# Correo automatico. En Hostinger suele usarse el puerto 465 con SSL.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_SECURITY=ssl

# WhatsApp Cloud API oficial de Meta. Si queda vacio, el administrador
# conserva los enlaces de envio manual desde el panel.
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
DEFAULT_COUNTRY_DIAL_CODE=57
